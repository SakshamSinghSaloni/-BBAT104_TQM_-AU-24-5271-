# Database Configuration
# Default: Local SQLite for rapid development and testing
DATABASE_URL=sqlite:///./backend/quiz_system.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/quiz_system

# Security & Authentication
# Replace with a cryptographically secure 256-bit secret in production
SECRET_KEY=production-secret-key-change-in-production-replace-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=quiz_session
